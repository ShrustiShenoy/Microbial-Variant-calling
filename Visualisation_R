# Create a ggplot with continuous x-axis and lines defining X and Y axes
# Load ggplot2 package
library(ggplot2)

# Create the plot
ggplot(counts, aes(x = reorder(mutation, -counts), y = counts)) +  # Reorder mutations by counts in descending order
  geom_bar(stat = "identity", fill = "skyblue") +  # Bar plot with actual counts
  geom_text(aes(label = counts), vjust = -0.3, color = "blue", size = 3) +  # Add text on top of bars
  labs(x = "Variation", y = "Counts") +  # Axis labels
  theme(axis.text.x = element_text(angle = 45, hjust = 1)) +  # Rotate x-axis labels for better readability
  theme_minimal() +  # Minimal theme for cleaner look
  theme(
    axis.line = element_line(color = "black", size = 1),  # Add black axis lines
    axis.ticks = element_line(color = "black"),  # Add ticks on the axes
    panel.border = element_rect(color = "black", fill = NA, size = 1)  # Add a border around the plot
  )
